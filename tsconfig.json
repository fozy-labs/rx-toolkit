{
  "extends": "@fozy-labs/js-configs/typescript",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "tsc-alias": {
    "replacers": {
      "base-url": { "enabled": false }
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "src/**/__tests__/**"]
}

{
  "name": "@fozy-labs/statechart-viz",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive mermaid-based visualizer for rx-toolkit statecharts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist && vite build && tsc -p tsconfig.build.json",
    "ts-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/ e2e/",
    "lint:fix": "eslint src/ e2e/ --fix",
    "format": "prettier --write src/ e2e/",
    "format:check": "prettier --check src/ e2e/",
    "check:all": "npm run ts-check && npm run test && npm run lint && npm run format:check && npm run test:e2e"
  },
  "dependencies": {
    "@fozy-labs/statechart-converter": "file:../converter",
    "svg-pan-zoom": "^3.6.2"
  },
  "peerDependencies": {
    "@fozy-labs/rx-toolkit": ">=0.11.0",
    "mermaid": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@fozy-labs/rx-toolkit": "file:../..",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@types/svg-pan-zoom": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.4.0",
    "jsdom": "^28.1.0",
    "mermaid": "11.17.2",
    "prettier": "^3.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.1.2",
    "rxjs": "^7.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  }
}

{
  "name": "@fozy-labs/statechart-converter",
  "version": "0.1.0",
  "private": true,
  "description": "Converts Mermaid stateDiagram-v2 files with %% @directives into typed @fozy-labs/rx-toolkit statechart definitions",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "statechart-convert": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "prettier": "@fozy-labs/js-configs/prettier",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "ts-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write src/ test/",
    "format:check": "prettier --check src/ test/",
    "check:all": "npm run ts-check && npm run test && npm run lint && npm run format:check",
    "convert": "npm run build --silent && node dist/cli.js"
  },
  "dependencies": {
    "@fozy-labs/rx-toolkit": "file:../..",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@fozy-labs/js-configs": "^0.1.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.3.5",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.0",
    "jiti": "^2.4.0",
    "jsdom": "^30.0.1",
    "mermaid": "11.17.2",
    "prettier": "^3.5.0",
    "rimraf": "6.1.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^4.0.18"
  }
}
